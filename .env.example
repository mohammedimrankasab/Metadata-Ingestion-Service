# HTTP

HTTP_PORT=8080

# Worker Pool

WORKER_COUNT=4
JOB_QUEUE_SIZE=100

# Sink Configuration
# Supported values:
# console
# json
# opensearch

SINK_TYPE=console

# JSON Sink

OUTPUT_FILE=metadata.json

# OpenSearch Sink

OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX=metadata

ENABLE_TRACING="false"